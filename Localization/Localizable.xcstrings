{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ reclaimable" : {
      "comment" : "Disk cleanup row — the value is the amount of disk space that pruning can free.",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "можна звільнити %@"
          }
        }
      }
    },
    "%@ stopped unexpectedly." : {
      "comment" : "Notification body — the value is the container name.",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контейнер %@ несподівано зупинився."
          }
        }
      }
    },
    "%@ · %lld platform variants" : {
      "comment" : "Image header — the first value is the image size, the second is the number of platform variants.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · %2$lld platform variant"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%1$@ · %2$lld platform variants"
                }
              }
            }
          }
        },
        "uk" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ · %lld варіанти платформи"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ · %lld варіантів платформи"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ · %lld варіант платформи"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ · %lld варіанта платформи"
                }
              }
            }
          }
        }
      }
    },
    "%@ — %@, needs %@" : {
      "comment" : "An unusable platform install — the first value is its path, the second its source and version, the third the version Davit needs.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ — %2$@, needs %3$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — %2$@, потрібна версія %3$@"
          }
        }
      }
    },
    "%@%% CPU · %@ · %@ disk" : {
      "comment" : "Live row summary — the first value is CPU usage, then memory, then disk usage.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%% CPU · %2$@ · %3$@ disk"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@%% CPU · %2$@ · диск %3$@"
          }
        }
      }
    },
    "%@.%@ must be a positive integer (got “%@”)" : {
      "comment" : "Validation error — the first two values are the config section and key, the third is the typed value.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@.%2$@ must be a positive integer (got “%3$@”)"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@.%2$@ має бути додатним цілим числом (отримано «%3$@»)"
          }
        }
      }
    },
    "%@: %@ was killed for exceeding its memory limit (limit %@). Increase memory with Edit & Recreate." : {
      "comment" : "Notification body — the first value is the container name, the second the killed process, the third the memory limit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ was killed for exceeding its memory limit (limit %3$@). Increase memory with Edit & Recreate."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@ примусово зупинено через перевищення ліміту пам’яті (ліміт %3$@). Збільште пам’ять через «Редагувати й перестворити»."
          }
        }
      }
    },
    "%@: %@ was killed for exceeding its memory limit. Increase memory with Edit & Recreate." : {
      "comment" : "Notification body — the first value is the container name, the second the killed process.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
