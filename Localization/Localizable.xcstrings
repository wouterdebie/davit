    "(unknown version)" : {
      "comment" : "Placeholder for a container platform whose version could not be read.",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(невідома версія)"
          }
        }
      }
    },
    "/usr/local/bin/container already exists (system install) — nothing to do." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл /usr/local/bin/container уже існує (системна інсталяція) — нічого робити."
          }
        }
      }
    },
    "A container machine is a lightweight VM you can use like a tiny Linux box — with your home directory mounted." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Машина-контейнер — це легка віртуальна машина, яку можна використовувати як крихітну Linux-систему зі змонтованим домашнім каталогом."
          }
        }
      }
    },
    "A lightweight VM booted from a container image, with your home directory mounted and a stable DNS name." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Легка віртуальна машина, завантажена з образу контейнера, зі змонтованим домашнім каталогом і стабільним DNS-ім’ям."
          }
        }
      }
    },
    "A native UI for Apple's container platform" : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нативний інтерфейс для платформи контейнерів Apple"
          }
        }
      }
    },
    "A process exceeded this container's memory limit and was killed by the kernel. Give it more memory and recreate it." : {
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процес перевищив ліміт пам’яті цього контейнера, і ядро примусово його зупинило. Збільште пам’ять і перестворіть контейнер."
          }
        }
      }
    },
    "A process exceeded this container's memory limit of %@ and was killed by the kernel. Give it more memory and recreate it." : {
      "comment" : "Why the container stopped — the value is the memory limit.",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Процес перевищив ліміт пам’яті цього контейнера (%@), і ядро примусово його зупинило. Збільште пам’ять і перестворіть контейнер."
          }
        }
      }
    },
    "A ticked service needs %@, which only runs under profile %@. Tick %@ too." : {
      "comment" : "Compose import error — the first and third values are the service name, the second is the profile name.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A ticked service needs %1$@, which only runs under profile %2$@. Tick %3$@ too."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позначеному сервісу потрібен %1$@, який працює лише в профілі %2$@. Позначте й %3$@."
          }
        }
      }
    },
