{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ reclaimable" : {
      "comment" : "Disk cleanup row — the value is the amount of disk space that pruning can free."
    },
    "%@ stopped unexpectedly." : {
      "comment" : "Notification body — the value is the container name."
    },
    "%@ · %lld platform variants" : {
      "comment" : "Image header — the first value is the image size, the second is the number of platform variants.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$lld platform variants"
          }
        }
      }
    },
    "%@ — %@, needs %@" : {
      "comment" : "An unusable platform install — the first value is its path, the second its source and version, the third the version Davit needs.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ — %2$@, needs %3$@"
          }
        }
      }
    },
    "%@%% CPU · %@ · %@ disk" : {
      "comment" : "Live row summary — the first value is CPU usage, then memory, then disk usage.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@%% CPU · %2$@ · %3$@ disk"
          }
        }
      }
    },
    "%@.%@ must be a positive integer (got “%@”)" : {
      "comment" : "Validation error — the first two values are the config section and key, the third is the typed value.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@.%2$@ must be a positive integer (got “%3$@”)"
          }
        }
      }
    },
    "%@: %@ was killed for exceeding its memory limit (limit %@). Increase memory with Edit & Recreate." : {
      "comment" : "Notification body — the first value is the container name, the second the killed process, the third the memory limit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ was killed for exceeding its memory limit (limit %3$@). Increase memory with Edit & Recreate."
          }
        }
      }
    },
    "%@: %@ was killed for exceeding its memory limit. Increase memory with Edit & Recreate." : {
      "comment" : "Notification body — the first value is the container name, the second the killed process.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@ was killed for exceeding its memory limit. Increase memory with Edit & Recreate."
          }
        }
      }
    },
    "%@: this amd64 image needs a newer Rosetta than your macOS provides. Update macOS, or run an arm64 image." : {
      "comment" : "Notification body — the value is the container name."
    },
    "%@: was killed for exceeding its memory limit (limit %@). Increase memory with Edit & Recreate." : {
      "comment" : "Notification body — the first value is the container name, the second the memory limit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: was killed for exceeding its memory limit (limit %2$@). Increase memory with Edit & Recreate."
          }
        }
      }
    },
    "%@: was killed for exceeding its memory limit. Increase memory with Edit & Recreate." : {
      "comment" : "Notification body — the value is the container name."
    },
    "%lld CPU · %@" : {
      "comment" : "Machine row — the first value is the CPU count, the second is the memory size.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld CPU · %2$@"
          }
        }
      }
    },
    "%lld CPUs allocated" : {
      "comment" : "Stats tile subtitle — the value is the number of CPUs assigned to the container."
    },
    "%lld CPUs · %@ memory" : {
      "comment" : "Resource summary — the first value is the CPU count, the second is the memory limit.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld CPUs · %2$@ memory"
          }
        }
      }
    },
    "%lld containers" : {
      "comment" : "Network row — the value is the number of containers attached to the network."
    },
    "%lld env" : {
      "comment" : "Compose service summary — the value is the number of environment variables."
    },
    "%lld layers" : {
      "comment" : "Layers tab heading — the value is the number of image layers."
    },
    "%lld mounts" : {
      "comment" : "Compose service summary — the value is the number of volume mounts."
    },
    "%lld running · %lld total" : {
      "comment" : "Resource summary — the first number is running containers, the second is the total.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld running · %2$lld total"
