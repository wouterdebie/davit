      }
    },
    "%@: this amd64 image needs a newer Rosetta than your macOS provides. Update macOS, or run an arm64 image." : {
      "comment" : "Notification body — the value is the container name.",
      "localizations" : {
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: цьому образу amd64 потрібна новіша версія Rosetta, ніж має ваш macOS. Оновіть macOS або запустіть образ arm64."
          }
        }
      }
    },
    "%@: was killed for exceeding its memory limit (limit %@). Increase memory with Edit & Recreate." : {
